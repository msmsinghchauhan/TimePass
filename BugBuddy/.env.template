# =============================================================================
# BugBuddy — Server Configuration Template
# =============================================================================
# ADMINISTRATOR SETUP — configure once before deploying the server.
# Users do NOT need to touch these settings; they are server-side only.
#
# Step 1:  cp .env.template .env
# Step 2:  Edit .env and fill in your credentials (see sections below)
# Step 3:  python setup_env.py          ← installs packages and validates config
# Step 4:  python app.py                ← start BugBuddy
#
# .env is loaded automatically by setup_env.py.  It can also be sourced:
#   source .env      (bash/zsh/mac)
#   . .env           (sh)
#
# Lines starting with # are comments. Do NOT quote values unless the value
# itself contains spaces.
# =============================================================================


# -----------------------------------------------------------------------------
# JIRA  (Required)
# -----------------------------------------------------------------------------

# Base URL of your Jira server
JIRA_SERVER=https://jira.ngage.netapp.com

# Personal Access Token — generate at:
#   <JIRA_SERVER>/secure/ViewProfile.jspa → Personal Access Tokens
JIRA_TOKEN=


# -----------------------------------------------------------------------------
# LLM Provider  (choose ONE option, fill in the matching key)
# -----------------------------------------------------------------------------
# The provider and model set here are used for ALL analysis requests.
# Users cannot override this from the web UI.

# --- OPTION A: NetApp internal LLM proxy  (recommended on corp network) ------
# Obtain key from the LLM Proxy portal
LLM_PROVIDER=netapp
LLM_MODEL=gpt-4.1
NETAPP_LLM_KEY=
# Available models: gpt-4.1 | gpt-4.1-mini | gpt-4o

# --- OPTION B: OpenAI direct  (comment out Option A first) -------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=
# Available models: gpt-4o | gpt-4o-mini | gpt-4-turbo

# --- OPTION C: Anthropic Claude  (comment out Option A first) ----------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=
# Available models: claude-3-5-sonnet-20241022 | claude-3-opus-20240229

# --- OPTION D: Google Gemini  (comment out Option A first) -------------------
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-pro
# GOOGLE_API_KEY=
# Available models: gemini-1.5-pro | gemini-1.5-flash

# --- OPTION E: Mock  (no key needed — returns placeholder data for testing) --
# LLM_PROVIDER=mock
# LLM_MODEL=


# -----------------------------------------------------------------------------
# Org Knowledge Proxy  (optional — for NetApp-internal term lookup)
# -----------------------------------------------------------------------------
# When ORG_KNOWLEDGE_KEY is set, BugBuddy makes an extra call to explain
# NetApp-specific terms found in the Jira ticket before running main analysis.
# Remove or leave blank to disable this feature.

# API key for the org knowledge proxy
ORG_KNOWLEDGE_KEY=

# Model to use on the knowledge proxy  (default: o1)
ORG_KNOWLEDGE_MODEL=o1

# Base URL of the knowledge proxy  (change only if using a different endpoint)
ORG_KNOWLEDGE_URL=https://llm-proxy-web.ai.openeng.netapp.com


# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Flask port  (default: 5001 — macOS blocks 5000 with AirPlay)
PORT=5001

# Flask session secret key — change to a long random string in production
SECRET_KEY=bugbuddy-dev-secret-change-in-prod
